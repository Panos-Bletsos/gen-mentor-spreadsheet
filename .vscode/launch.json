{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend (FastAPI)",
      "type": "python",
      "request": "launch",
      "python": "${workspaceFolder}/backend/.venv/bin/python",
      "module": "uvicorn",
      "args": [
        "main:app",
        "--reload",
        "--port",
        "5001"
      ],
      "jinja": true,
      "justMyCode": true,
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "preLaunchTask": "Stop all services"
    },
    {
      "name": "Frontend (Streamlit)",
      "type": "python",
      "request": "launch",
      "python": "${workspaceFolder}/frontend/.venv/bin/python",
      "module": "streamlit",
      "args": [
        "run",
        "main.py",
        "--server.port",
        "8502"
      ],
      "jinja": true,
      "justMyCode": true,
      "cwd": "${workspaceFolder}/frontend",
      "console": "integratedTerminal",
      "preLaunchTask": "Stop all services"
    }
  ],
  "compounds": [
    {
      "name": "Full Stack (Backend + Frontend)",
      "configurations": [
        "Backend (FastAPI)",
        "Frontend (Streamlit)"
      ],
      "stopAll": true
    }
  ]
}
